# Configurações do Banco de Dados Local (PostgreSQL)
POSTGRES_DB=finance_db
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=finance_password
POSTGRES_PORT=5432

# Configurações do Backend Spring Boot
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Configurações do Frontend
VITE_API_URL=http://localhost:8080/api/v1

# Configurações de Envio de E-mail (Opcional - Gratuito via Gmail, Brevo ou Resend)
# Para Gmail: ative a Verificação em 2 etapas na conta Google e gere uma Senha de App de 16 letras
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=seuemail@gmail.com
SPRING_MAIL_PASSWORD=sua-senha-de-app-16-letras

# Google Analytics 4 (GA4) & Google Search Console (GSC)
# Obtenha o Measurement ID no Google Analytics 4 (ex: G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=
# Obtenha o código de verificação HTML tag no Google Search Console (apenas o valor do content)
VITE_GSC_VERIFICATION_CODE=

